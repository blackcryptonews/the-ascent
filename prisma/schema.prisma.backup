// Giant Within - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  name                  String?
  password              String?  // For email/password auth
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  onboardingCompleted   Boolean  @default(false)
  timezone              String   @default("UTC")
  notificationPreferences Json?

  profile               UserProfile?
  dailyQuestions        DailyQuestion[]
  dailyQuotes           DailyQuote[]
  habits                Habit[]
  painPleasureExercises PainPleasureExercise[]
  journalEntries        JournalEntry[]
  aiInsights            AIInsight[]
  activityLogs          ActivityLog[]

  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryGoals    String[]
  negativeWords   String[] @default([])
  currentFocusArea String?
  streakCount     Int      @default(0)
  lastActivityDate DateTime?
  totalPoints     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profiles")
}

model DailyQuestion {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionText     String
  questionType     String?   // 'gratitude', 'action', 'reflection'
  responseText     String?
  responseVoiceUrl String?
  responseSentiment String?  // 'positive', 'neutral', 'negative'
  createdAt        DateTime  @default(now())
  answeredAt       DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@map("daily_questions")
}

model DailyQuote {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteText      String
  quoteAuthor    String?
  relevanceScore Float?
  createdAt      DateTime @default(now())

  @@map("daily_quotes")
}

model Habit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitName       String
  habitType       String   // 'break' or 'build'
  currentBehavior String
  desiredBehavior String
  status          String   @default("active") // 'active', 'paused', 'completed'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  painPleasureExercises PainPleasureExercise[]

  @@index([userId, status])
  @@map("habits")
}

model PainPleasureExercise {
  id                    String    @id @default(uuid())
  habitId               String
  habit                 Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pain associations
  painScenario          String?
  painVisualization     String?
  painIntensity         Int?

  // Pleasure associations
  pleasureScenario      String?
  pleasureVisualization String?
  pleasureIntensity     Int?

  completedAt           DateTime?
  replayCount           Int       @default(0)
  lastReplayedAt        DateTime?
  createdAt             DateTime  @default(now())

  @@map("pain_pleasure_exercises")
}

model JournalEntry {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryText       String
  entryType       String?  // 'free', 'guided', 'question_response'
  sentimentScore  Float?
  detectedPatterns Json?
  negativeWordsUsed String[] @default([])
  aiInsights      String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("journal_entries")
}

model AIInsight {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightType     String   // 'pattern', 'recommendation', 'encouragement'
  insightText     String
  confidenceScore Float?
  relatedEntryId  String?
  actedUpon       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_insights")
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String
  activityData Json?
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_logs")
}
